# Application
SECRET_KEY=your-super-secret-key-here-min-32-chars
ENVIRONMENT=development
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Database
POSTGRES_DB=datashield
POSTGRES_USER=datashield
POSTGRES_PASSWORD=changeme_strong_password

# Redis
REDIS_PASSWORD=changeme_strong_password

# MinIO / S3 Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_strong_password
MINIO_BUCKET_NAME=datashield-evidence

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# MFA
TOTP_ISSUER=DataShield OSINT

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@datashield.com

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# AI (OpenAI)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o

# OSINT APIs
HIBP_API_KEY=your-haveibeenpwned-api-key
GOOGLE_SEARCH_API_KEY=your-google-api-key
GOOGLE_SEARCH_ENGINE_ID=your-search-engine-id
BING_SEARCH_API_KEY=your-bing-api-key

# SHODAN (optional, free tier works — https://account.shodan.io/)
SHODAN_API_KEY=your-shodan-api-key

# Monitoring
GRAFANA_PASSWORD=changeme_strong_password

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
SCAN_RATE_LIMIT_PER_HOUR=10

# Celery
CELERY_BROKER_URL=redis://:changeme@redis:6379/1
CELERY_RESULT_BACKEND=redis://:changeme@redis:6379/2
