{
  "title": "DataShield OSINT — Platform Dashboard",
  "uid": "datashield-main",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "API Request Rate",
      "type": "graph",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "rate(http_requests_total{job=\"datashield-backend\"}[5m])",
          "legendFormat": "{{method}} {{handler}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "API Response Time (p95)",
      "type": "graph",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"datashield-backend\"}[5m]))",
          "legendFormat": "p95 latency"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error Rate (5xx)",
      "type": "stat",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "rate(http_requests_total{job=\"datashield-backend\",status=~\"5..\"}[5m])",
          "legendFormat": "Error rate"
        }
      ],
      "options": { "colorMode": "background", "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 0.01 }] } }
    },
    {
      "id": 4,
      "title": "Active Scans (Celery Queue)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 6 },
      "targets": [
        { "expr": "celery_tasks_active_total", "legendFormat": "Active Tasks" }
      ]
    },
    {
      "id": 5,
      "title": "Redis Memory Usage",
      "type": "gauge",
      "gridPos": { "x": 6, "y": 8, "w": 6, "h": 6 },
      "targets": [
        { "expr": "redis_memory_used_bytes", "legendFormat": "Memory" }
      ]
    },
    {
      "id": 6,
      "title": "PostgreSQL Connections",
      "type": "stat",
      "gridPos": { "x": 12, "y": 8, "w": 6, "h": 6 },
      "targets": [
        { "expr": "pg_stat_activity_count", "legendFormat": "DB Connections" }
      ]
    },
    {
      "id": 7,
      "title": "CPU Usage",
      "type": "graph",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "targets": [
        { "expr": "rate(process_cpu_seconds_total{job=\"datashield-backend\"}[5m]) * 100", "legendFormat": "CPU %" }
      ]
    },
    {
      "id": 8,
      "title": "Memory Usage",
      "type": "graph",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 8 },
      "targets": [
        { "expr": "process_resident_memory_bytes{job=\"datashield-backend\"} / 1024 / 1024", "legendFormat": "RSS MB" }
      ]
    }
  ]
}
